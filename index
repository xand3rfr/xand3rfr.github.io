    <script>
        // Data storage (using localStorage)
        const STORAGE_KEYS = {
            announcements: 'zsmp_announcements',
            suggestions: 'zsmp_suggestions'
        };

        // Get data from localStorage
        function getStoredData(key) {
            const data = localStorage.getItem(key);
            return data ? JSON.parse(data) : [];
        }

        // Save data to localStorage
        function saveData(key, data) {
            localStorage.setItem(key, JSON.stringify(data));
        }

        // Generate animated particles
        function generateParticles() {
            const container = document.getElementById('particleContainer');
            const particleCount = window.innerWidth < 768 ? 20 : 40;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                
                const size = Math.random() * 40 + 20;
                const left = Math.random() * 100;
                const duration = Math.random() * 10 + 10;
                const delay = Math.random() * 5;
                
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.left = left + '%';
                particle.style.bottom = '-100px';
                particle.style.animationDuration = duration + 's';
                particle.style.animationDelay = delay + 's';
                
                container.appendChild(particle);
            }
        }

        // Copy to clipboard
        document.getElementById('copyBtn').addEventListener('click', function() {
            const ip = document.getElementById('ipAddress').textContent;
            navigator.clipboard.writeText(ip).then(() => {
                const btn = this;
                btn.classList.add('copied');
                btn.textContent = '✓ Copied!';
                setTimeout(() => {
                    btn.classList.remove('copied');
                    btn.textContent = 'Copy IP';
                }, 2000);
            });
        });

        // Update player count
        function updatePlayerCount() {
            const count = Math.floor(Math.random() * 50) + 5;
            document.getElementById('playerCount').textContent = count;
        }

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        const ADMIN_PASSWORD = "changeme";

        // Admin Password Functions
        function openAdminPanel() {
            document.getElementById('passwordModal').classList.add('active');
            document.getElementById('adminPasswordInput').focus();
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.remove('active');
        }

        function checkAdminPassword() {
            const input = document.getElementById('adminPasswordInput');
            const error = document.getElementById('passwordError');

            if (input.value === ADMIN_PASSWORD) {
                closePasswordModal();
                document.getElementById('adminModal').classList.add('active');
                loadSuggestions();
                input.value = '';
                error.style.display = 'none';
            } else {
                error.style.display = 'block';
                input.style.borderColor = '#ff4d6d';
                input.animate([
                    { transform: 'translateX(-6px)' },
                    { transform: 'translateX(6px)' },
                    { transform: 'translateX(0)' }
                ], {
                    duration: 300
                });
            }
        }

        // Show password toggle
        document.addEventListener('DOMContentLoaded', () => {
            const toggle = document.getElementById('showPasswordToggle');
            if(toggle){
                toggle.addEventListener('change', function() {
                    const input = document.getElementById('adminPasswordInput');
                    input.type = this.checked ? 'text' : 'password';
                });
            }
        });

        // Enter key support
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && document.getElementById('passwordModal').classList.contains('active')) {
                checkAdminPassword();
            }
        });

        // Admin Panel Functions

        function closeAdminPanel() {
            document.getElementById('adminModal').classList.remove('active');
        }

        function switchAdminTab(tabName) {
            // Hide all forms
            document.querySelectorAll('.admin-form').forEach(form => {
                form.classList.remove('active');
            });

            // Remove active class from all tabs
            document.querySelectorAll('.admin-tab').forEach(tab => {
                tab.classList.remove('active');
            });

            // Show selected form
            if (tabName === 'announcements') {
                document.getElementById('announcementsForm').classList.add('active');
                document.querySelector('[onclick="switchAdminTab(\'announcements\')"]').classList.add('active');
            } else if (tabName === 'manage-suggestions') {
                document.getElementById('manageSuggestionsForm').classList.add('active');
                document.querySelector('[onclick="switchAdminTab(\'manage-suggestions\')"]').classList.add('active');
                loadSuggestions();
            } else if (tabName === 'links') {
                document.getElementById('linksForm').classList.add('active');
                document.querySelector('[onclick="switchAdminTab(\'links\')"]').classList.add('active');
                loadSavedLinks();
            }
        }

        function postAnnouncement(event) {
            event.preventDefault();

            const title = document.getElementById('announcementTitleInput').value;
            const content = document.getElementById('announcementContentInput').value;

            const announcement = {
                id: Date.now(),
                title: title,
                content: content,
                timestamp: new Date().toLocaleString()
            };

            // Get existing announcements
            let announcements = getStoredData(STORAGE_KEYS.announcements);
            announcements.unshift(announcement);
            saveData(STORAGE_KEYS.announcements, announcements);

            // Show the announcement
            displayAnnouncement(announcement);

            // Clear form
            document.getElementById('announcementTitleInput').value = '';
            document.getElementById('announcementContentInput').value = '';

            // Close panel
            closeAdminPanel();

            // Show success message
            alert('✓ Announcement posted successfully!');
        }

        function displayAnnouncement(announcement) {
            const banner = document.getElementById('announcementBanner');
            document.getElementById('announcementTitle').textContent = announcement.title;
            document.getElementById('announcementContent').textContent = announcement.content;
            banner.classList.add('active');
        }

        function closeAnnouncement() {
            document.getElementById('announcementBanner').classList.remove('active');
        }

        function submitSuggestion(event) {
            event.preventDefault();

            const content = document.getElementById('suggestionInput').value;

            const suggestion = {
                id: Date.now(),
                content: content,
                author: 'Friend #' + Math.floor(Math.random() * 1000),
                timestamp: new Date().toLocaleString(),
                status: 'pending'
            };

            // Get existing suggestions
            let suggestions = getStoredData(STORAGE_KEYS.suggestions);
            suggestions.unshift(suggestion);
            saveData(STORAGE_KEYS.suggestions, suggestions);

            // Clear input
            document.getElementById('suggestionInput').value = '';

            // Refresh display
            displaySuggestions();
            loadSavedLinks();

            // Show success
            alert('✓ Thanks for your suggestion! It will be reviewed by admins.');
        }

        function displaySuggestions() {
            const suggestions = getStoredData(STORAGE_KEYS.suggestions);
            const container = document.getElementById('suggestionsContainer');

            if (suggestions.length === 0) {
                container.innerHTML = '<p style="color: var(--text-muted); text-align: center;">Be the first to submit a suggestion!</p>';
                return;
            }

            container.innerHTML = suggestions.map(sugg => `
                <div class="suggestion-item" style="animation: slideInUp 0.5s ease-out;">
                    <div class="suggestion-header">
                        <div class="suggestion-author">${sugg.author}</div>
                        <span style="color: var(--text-muted); font-size: 0.85rem;">${sugg.timestamp}</span>
                    </div>
                    <div class="suggestion-text">${sugg.content}</div>
                    <span class="suggestion-status ${sugg.status}">${sugg.status.charAt(0).toUpperCase() + sugg.status.slice(1)}</span>
                </div>
            `).join('');
        }

        function loadSuggestions() {
            const suggestions = getStoredData(STORAGE_KEYS.suggestions);
            const container = document.getElementById('suggestionsList');

            if (suggestions.length === 0) {
                container.innerHTML = '<p style="color: var(--text-muted);">No suggestions yet. Check back later!</p>';
                return;
            }

            container.innerHTML = suggestions.map(sugg => `
                <div class="suggestion-item">
                    <div class="suggestion-header">
                        <div style="flex: 1;">
                            <div class="suggestion-author">${sugg.author}</div>
                            <div class="suggestion-text">${sugg.content}</div>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <button onclick="updateSuggestionStatus(${sugg.id}, 'approved')" style="padding: 0.3rem 0.8rem; background: rgba(0, 255, 136, 0.2); border: 1px solid var(--accent-green); border-radius: 5px; color: var(--accent-green); cursor: pointer; font-size: 0.8rem; font-weight: 600;">✓</button>
                            <button onclick="updateSuggestionStatus(${sugg.id}, 'rejected')" style="padding: 0.3rem 0.8rem; background: rgba(255, 107, 53, 0.2); border: 1px solid #ff6b35; border-radius: 5px; color: #ff6b35; cursor: pointer; font-size: 0.8rem; font-weight: 600;">✕</button>
                        </div>
                    </div>
                    <span class="suggestion-status ${sugg.status}">${sugg.status.charAt(0).toUpperCase() + sugg.status.slice(1)}</span>
                </div>
            `).join('');
        }

        function updateSuggestionStatus(id, newStatus) {
            let suggestions = getStoredData(STORAGE_KEYS.suggestions);
            suggestions = suggestions.map(sugg => 
                sugg.id === id ? { ...sugg, status: newStatus } : sugg
            );
            saveData(STORAGE_KEYS.suggestions, suggestions);
            loadSuggestions();
            displaySuggestions();
            loadSavedLinks();
        }

        
        function saveLinks() {
            const links = {
                discord: document.getElementById('discordLinkInput').value,
                donation: document.getElementById('donationLinkInput').value,
                eagler1: document.getElementById('eagler1Input').value,
                eagler2: document.getElementById('eagler2Input').value,
                eagler3: document.getElementById('eagler3Input').value
            };

            localStorage.setItem('zsmp_links', JSON.stringify(links));

            if (links.discord) {
                document.querySelectorAll('#discordLink').forEach(link => {
                    link.href = links.discord;
                });
            }

            alert('✓ Links Updated!');
        }

        function loadSavedLinks() {
            const links = JSON.parse(localStorage.getItem('zsmp_links') || '{}');

            if(document.getElementById('discordLinkInput')){
                document.getElementById('discordLinkInput').value = links.discord || '';
                document.getElementById('donationLinkInput').value = links.donation || '';
                document.getElementById('eagler1Input').value = links.eagler1 || '';
                document.getElementById('eagler2Input').value = links.eagler2 || '';
                document.getElementById('eagler3Input').value = links.eagler3 || '';
            }

            if (links.discord) {
                document.querySelectorAll('#discordLink').forEach(link => {
                    link.href = links.discord;
                });
            }
        }

        function openDonation() {
            const links = JSON.parse(localStorage.getItem('zsmp_links') || '{}');

            if (links.donation) {
                window.open(links.donation, '_blank');
            } else {
                alert('Donation link not set yet.');
            }
        }


        // Scroll animation observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.scroll-in').forEach(el => {
            observer.observe(el);
        });

        // Initialize on load
        window.addEventListener('load', () => {
            generateParticles();
            updatePlayerCount();
            displaySuggestions();
            loadSavedLinks();

            // Display last announcement if any
            const announcements = getStoredData(STORAGE_KEYS.announcements);
            if (announcements.length > 0) {
                displayAnnouncement(announcements[0]);
                setTimeout(() => closeAnnouncement(), 10000);
            }
        });

        // Close admin modal when clicking outside
        document.getElementById('adminModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAdminPanel();
            }
        });

        // Recalculate particles on window resize
        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                document.getElementById('particleContainer').innerHTML = '';
                generateParticles();
            }, 250);
        });
    </script>
</body>
</html>
